#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/sbin/devmond

start_service() {
	config_load devmon
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

service_stopped() {
	nft delete table inet devmon 2>/dev/null
	return 0
}

# devmond 每轮自己重读配置，改设备名、拉黑、改采样间隔都不需要重启；
# 重启会清空累计流量和历史曲线，所以 reload 只处理启用开关
reload_service() {
	config_load devmon
	config_get_bool enabled main enabled 1
	if [ "$enabled" = 1 ]; then
		start
	else
		stop
	fi
}

service_triggers() {
	procd_add_reload_trigger devmon
}
