#!/bin/sh
#
# JDCloud RE-SS-01 首次启动默认值。
#

. /lib/functions.sh

[ "$(board_name)" = "jdcloud,re-ss-01" ] || exit 0

# uci-defaults 在每次 sysupgrade 后都会重跑（脚本执行后留下的 whiteout
# 不在备份里），保留配置升级时会把用户改过的 DHCP、手动开启的
# tailscale/frpc 等全部重置。system 里记录已应用到第几批默认值
# （随 /etc/config/system 一起被保留），升级时只补跑新增的批次。
# 以后新增默认值：追加一个 [ "$ver" -lt N ] 段，并把末尾的标记改成 N。
ver="$(uci -q get system.@system[0].re_ss_01_defaults)"
case "$ver" in
	''|*[!0-9]*) ver=0 ;;
esac

# ---- 第 1 批：首次安装 ----
if [ "$ver" -lt 1 ]; then

# LAN 口 DHCPv4 强制开启。
# dnsmasq 启动前会用 udhcpc 探测 br-lan 上是否已有 DHCP 服务器，
# 探测到就拒绝下发地址（只剩 odhcpd 的 IPv6 RA），这里用 force 跳过探测。
uci -q batch <<-EOF >/dev/null
	set dhcp.lan=dhcp
	set dhcp.lan.interface='lan'
	set dhcp.lan.start='100'
	set dhcp.lan.limit='150'
	set dhcp.lan.leasetime='12h'
	set dhcp.lan.dhcpv4='server'
	set dhcp.lan.force='1'
	delete dhcp.lan.ignore
	commit dhcp
EOF

# iStoreOS 的 zram-swap 默认关闭（需 zram_enabled=1 才启动）
uci -q batch <<-EOF >/dev/null
	set system.@system[0].zram_enabled='1'
	commit system
EOF

# 软件流量卸载必须关闭：flowtable 会让已建立连接的后续包走快速路径、
# 绕过 dae/daed 的 tc eBPF，造成 TLS 握手中途数据错乱（dae 官方亦要求关闭）
uci -q batch <<-EOF >/dev/null
	set firewall.@defaults[0].flow_offloading='0'
	commit firewall
EOF

# 未配置就默认启动的服务：
#   frpc       示例配置连 127.0.0.1:7000，开机即进入 crash loop
#   haproxy    示例配置监听 :81 :444 :60000（passwall 用自己的配置另行拉起）
#   tailscale  未登录也常驻约 70MB 内存
#   mwan3      单 WAN 下无意义，持续 ping 1.1.1.1 刷日志，且其 fwmark/策略路由
#              与 dae/daed 的打标路由有潜在冲突
# procd 在 S10boot 之前就展开了 rc.d 列表，这里删掉软链后本次启动即不再拉起
for s in frpc haproxy tailscale mwan3; do
	[ -x "/etc/init.d/$s" ] && "/etc/init.d/$s" disable
done

# watchcat 上游默认 6 小时 ping 不通 8.8.8.8 就重启，国内 8.8.8.8 不稳定，
# 容易误重启。换成国内公共 DNS，任一能 ping 通即视为在线。
if [ "$(uci -q get watchcat.@watchcat[0].pinghosts)" = "8.8.8.8" ]; then
	uci -q batch <<-EOF >/dev/null
		set watchcat.@watchcat[0].pinghosts='223.5.5.5 119.29.29.29'
		commit watchcat
	EOF
fi

fi

# ---- 第 2 批：zram zstd、adblock ----
# 已装机升级上来也会执行一次，所以只改仍是出厂值 / 自动探测错误的项，
# 不覆盖用户自己改过的设置。
if [ "$ver" -lt 2 ]; then

# 内核已编入 zstd 后端，压缩率明显高于 lzo，小内存机型能多换出不少页。
# zram.init 在未设置时回落到 lzo，所以未设置也按出厂值处理。
case "$(uci -q get system.@system[0].zram_comp_algo)" in
''|lzo|lzo-rle)
	uci -q batch <<-EOF >/dev/null
		set system.@system[0].zram_comp_algo='zstd'
		commit system
	EOF
	;;
esac

# adblock 默认开启，但会按 smartdns -> dnsmasq 的顺序自动选 DNS 后端，
# 而 smartdns 默认不运行，结果拦截 0 条；也没有触发接口，开机时 WAN 未通
# 下载失败后不再重试。改用 dnsmasq，WAN/WWAN 上线后再拉规则。
adb_dns="$(uci -q get adblock.global.adb_dns)"
if [ -z "$adb_dns" ] || { [ "$adb_dns" = "smartdns" ] && \
		[ "$(uci -q get smartdns.@smartdns[0].enabled)" != "1" ]; }; then
	uci -q set adblock.global.adb_dns='dnsmasq'
fi
[ -n "$(uci -q get adblock.global.adb_trigger)" ] || uci -q batch <<-EOF >/dev/null
	add_list adblock.global.adb_trigger='wan'
	add_list adblock.global.adb_trigger='wwan'
EOF
# 规则源只留针对国内广告的 anti_ad（约 10 万条，9 秒完成）：出厂的 certpl
# 国内连不上，adguard 走 GitHub Pages 常卡在传输中途（实测 4 分 44 秒）。
if [ "$(uci -q get adblock.global.adb_feed)" = "adguard adguard_tracking certpl" ]; then
	uci -q batch <<-EOF >/dev/null
		delete adblock.global.adb_feed
		add_list adblock.global.adb_feed='anti_ad'
	EOF
fi
# adblock 的 curl 只有 --connect-timeout，连上后不动会一直挂住整轮更新，
# 这里补上 --max-time，其余参数与 adblock.sh 的默认值一致（仅适用于 curl）。
# 出厂没有 adb_fetchcmd，adblock 运行时才自动探测（curl 排第一），这里提前写明。
adb_fetch="$(uci -q get adblock.global.adb_fetchcmd)"
if [ -z "$adb_fetch" ] && command -v curl >/dev/null; then
	adb_fetch=curl
	uci -q set adblock.global.adb_fetchcmd='curl'
fi
[ "$adb_fetch" = "curl" ] && [ -z "$(uci -q get adblock.global.adb_fetchparm)" ] && \
	uci -q set adblock.global.adb_fetchparm='--connect-timeout 20 --max-time 180 --retry-delay 10 --retry 4 --retry-max-time 80 --retry-all-errors --fail --silent --show-error --location -o'
uci -q commit adblock

fi

uci -q batch <<-EOF >/dev/null
	set system.@system[0].re_ss_01_defaults='2'
	commit system
EOF

exit 0
